{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "type": "command",
        "command": "./hooks/block-generated-files-cursor.sh"
      },
      {
        "type": "command",
        "command": "./hooks/block-inline-frontend-cursor.sh"
      }
    ],
    "beforeShellExecution": [
      {
        "type": "command",
        "command": "./hooks/block-tsc-cursor.sh"
      }
    ]
  }
}
