{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(wsl bash -lc *)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/block-generated-files.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/require-wsl-for-b6p.sh" },
          { "type": "command", "command": ".claude/hooks/block-tsc.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/prettier-on-save.sh" }
        ]
      }
    ]
  }
}
