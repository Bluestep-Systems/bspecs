node_modules/
build/
.env
.env.local
*.log
.DS_Store
.claude/settings.local.json
# Spec/handoff working docs — kept local, not shipped to this public repo. They can reference
# disposable spike details (org subdomains, file IDs, etc.); the shipped artifacts are the plugin
# reference files, skills, and the ADRs under docs/decisions/. NOTE: specs committed before this
# rule was added stay tracked until removed with `git rm --cached`.
.claude/specs/
# Disposable experiment workspaces (vite-merge-report-test etc.) — nested projects with
# their own git repos and pulled reference components; never ship with the plugin.
experiments/
# Pulled b6p component working copies (org-numbered trees). They hold real config values
# and platform-generated declarations — never commit them to this public repo.
platform/U*/
# NEVER commit private keys / secrets (e.g. a GitHub App private key). Belt-and-suspenders
# so a stray key file in the working tree can't be staged into this public repo.
*.pem
*.key
*.pkcs8
