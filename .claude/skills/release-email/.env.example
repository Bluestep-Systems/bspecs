# release-email skill — configuration.
#
# Copy this file to `.env` in this same directory and fill in the real values:
#   cp .env.example .env
# `.env` is gitignored (repo-wide), so the real values never enter this public
# repo. The skill loads this file directly — no ~/.profile / shell-startup
# dependency.

# The deployed send endpoint URL (org-specific — keep it in .env, not here).
B6P_RELEASE_EMAIL_URL=https://<your-bluestep-host>/b/bspecs-release-email

# HTTP Basic Auth as user:secret — a BlueStep login, or (preferred) a scoped
# token / dedicated service account, that has access to the endpoint.
# NEVER commit the real value.
B6P_RELEASE_EMAIL_AUTH=your-username:your-password-or-token
